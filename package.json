{
  "name": "@zeropress/studio",
  "description": "Self-hosted content management and publishing control for ZeroPress",
  "version": "0.7.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/init-dev-vars.mjs",
    "dev": "X_LOCAL_OBSERVABILITY=true vite",
    "predev:enable-remote": "node scripts/check-remote-development.mjs",
    "dev:enable-remote": "vite --mode enable-remote",
    "build": "node scripts/build-deploy.mjs build",
    "preview": "node scripts/build-deploy.mjs build --mode local-preview && vite preview --mode local-preview",
    "preview:wrangler": "node scripts/build-deploy.mjs build --mode local-preview && wrangler dev --config dist/zeropress_studio/wrangler.json --local --persist-to client/.wrangler/state",
    "test": "vitest --run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:ui": "node scripts/run-e2e.mjs --ui",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "update:passkey-names": "node scripts/update-passkey-names.mjs",
    "deploy": "node scripts/build-deploy.mjs deploy",
    "deploy:dry-run": "node scripts/build-deploy.mjs dry-run"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
