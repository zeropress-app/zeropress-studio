{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zeropress-studio",
  "main": "./worker/src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  // Plain variables are Dashboard-owned and survive code deployments.
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["23 18 * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__zeropress_media__/*"]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zeropress-studio-d1"
    },
    {
      "binding": "EDGE_DB",
      "database_name": "zeropress-edge-d1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "EDGE_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "zeropress-edge-mail-queue"
      }
    ],
    "consumers": [
      {
        "queue": "zeropress-edge-mail-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "zeropress-studio-media"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_ROUTE_RATE_LIMITER",
      "namespace_id": "800001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "AI_REQUEST_RATE_LIMITER",
      "namespace_id": "800002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
